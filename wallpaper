                <a href="https://linkedin.com" target="_blank" class="glass p-4 rounded-xl hover:bg-white/15 transition-all flex flex-col items-center gap-2 group">
                    <i data-lucide="linkedin" class="w-6 h-6 text-indigo-300 group-hover:scale-110 transition-transform"></i>
                    <span class="text-xs font-semibold">LinkedIn</span>
