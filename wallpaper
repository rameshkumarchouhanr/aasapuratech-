                <a href="https://youtube.com" target="_blank" class="glass p-4 rounded-xl hover:bg-white/15 transition-all flex flex-col items-center gap-2 group">
                    <i data-lucide="youtube" class="w-6 h-6 text-rose-400 group-hover:scale-110 transition-transform"></i>
