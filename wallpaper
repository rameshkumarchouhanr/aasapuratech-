                        class="bg-slate-900/60 border border-slate-700/60 rounded-xl pl-9 pr-4 py-2 text-sm focus:outline-none focus:border-indigo-500 w-64 md:w-80 transition-all text-slate-200 placeholder-slate-500">
                </div>

                <!-- Customizer Toggle -->
